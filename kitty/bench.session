# Round-3 benchmark arena: three equal columns, one agent each.
#   kitty --session ~/.config/kitty/bench.session
#
# horizontal keeps all three windows in one row at exactly 1/3 width each, so
# nothing needs resizing before recording. Titles show which agent is which.

new_tab round-3
layout horizontal

launch --title empryo   --cwd ~/dev/hono-bench-empryo   zsh
launch --title opencode --cwd ~/dev/hono-bench-opencode zsh
launch --title pi       --cwd ~/dev/hono-bench-pi       zsh
